# Copy this file to .env and fill in your own values.
# Never commit the real .env file to GitHub.

# Get this from MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inkwell?retryWrites=true&w=majority

# Any long random string — used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server runs on locally
PORT=5000
